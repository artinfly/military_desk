# Образец настроек. Скопируйте в .env и заполните своими значениями.
# Сам .env в git не попадает.

# Секретный ключ Django: длинная случайная строка, своя на каждой машине.
# Получить: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True — подробные страницы ошибок (только для разработки)
DEBUG=True

# Адреса, по которым открывается сайт, через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=military_desk_test
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
