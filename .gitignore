# Виртуальное окружение Python — у каждого своё, создаётся заново по requirements.txt
.venv/

# Настройки машины: пароли, ключи, адреса
.env
.env.*
!.env.example

# Файлы, которые Python и Django создают сами
__pycache__/
*.py[cod]
staticfiles/
media/
*.log

# Выгрузки и загружаемые пользователями файлы
*.xlsx
*.zip
*.xls
*.csv
*.tsv
*.dbf
*.sql
*.dump
*.json.gz

# Настройки редакторов и системы
.vscode/
.idea/
Thumbs.db
